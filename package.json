{
  "name": "assistente-suporte-prompt-harness",
  "version": "1.0.0",
  "description": "Assistente de atendimento ao cliente com geração de respostas técnicas personalizadas, Engenharia de Prompt versionada, SDD e Prompt Evaluation Harness",
  "type": "module",
  "main": "src/cli.js",
  "bin": {
    "support-harness": "./src/cli.js"
  },
  "scripts": {
