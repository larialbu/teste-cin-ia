# Provedor de IA: Google Gemini API
LLM_PROVIDER=gemini

# Chave de API do Google Gemini (obtenha gratuitamente em https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Modelo padrão do Gemini
GEMINI_MODEL=gemini-3.8-flash

# Temperatura para geração consistente (0.0 a 1.0)
LLM_TEMPERATURE=0.2

# Porta para a interface Web (http://localhost:3000)
PORT=3000
